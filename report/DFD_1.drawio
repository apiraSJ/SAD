        <mxCell id="p3" parent="1" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#FEFCBF;strokeColor=#D69E2E;fontSize=12;fontColor=#744210;" value="3.0&#xa;มอบหมายงานซ่อม&#xa;(Assign Repair&#xa;Task)" vertex="1">
