        <mxCell id="ext_student" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF8FF;strokeColor=#3182CE;fontSize=13;fontColor=#2B6CB0;fontStyle=1;" value="นักเรียนนายเรืออากาศ&#xa;(Cadet)" vertex="1">
